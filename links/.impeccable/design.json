 24%,var(--blue) 100%);box-shadow:0 12px 40px -18px rgba(0,177,226,.6)}.ds-card--cta:hover,.ds-card--cta:focus-visible{border-color:transparent;box-shadow:0 16px 50px -16px rgba(0,177,226,.7)}.ds-card--cta:focus-visible{outline:2px solid #fff;outline-offset:-4px}.ds-card--cta .ds-card__icon{width:48px;height:48px;border-radius:14px;color:#fff;background:rgba(255,255,255,.15)}.ds-card--cta .ds-card__icon svg{width:24px;height:24px}.ds-card--cta .ds-card__title{font-weight:700;font-size:17px;line-height:1.15}.ds-card--cta .ds-card__sub{margin-top:4px;font-size:13px;line-height:1.3;color:rgba(255,255,255,.88)}.ds-card--cta .ds-card__chev,.ds-card--cta:hover .ds-card__chev{width:20px;height:20px;color:#fff;opacity:.9}@media (prefers-reduced-motion: reduce){.ds-cta-wrap::before{display:none}}"
