    {
      "name": "Link Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Navy card for every supporting link; lifts with a cyan hairline on hover.",
      "html": "<a class=\"ds-card\" href=\"#\"><span class=\"ds-card__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z\"/><path d=\"M19 10v2a7 7 0 0 1-14 0v-2\"/><path d=\"M12 19v3\"/></svg></span><span class=\"ds-card__text\"><span class=\"ds-card__title\">Palestras e convites</span><span class=\"ds-card__sub\">Eventos, podcasts e entrevistas</span></span><span class=\"ds-card__chev\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"/></svg></span></a>",
      "css": ":root{--bg-from:#161F28;--bg-to:#0F1620;--navy:#16274A;--cyan:#00B1E2;--blue:#0060AB;--cta-mid:#027DB8;--text:#F4F8FA;--text-soft:#DCE4E2;--muted:#8AA0B5;--border:rgba(255,255,255,0.08);--border-hover:rgba(0,177,226,0.4);--pending:#FFC857;--font-display:\"Poppins\",ui-sans-serif,system-ui,sans-serif;--font-body:\"DM Sans\",ui-sans-serif,system-ui,sans-serif}.ds-card{display:flex;align-items:center;gap:14px;min-height:64px;padding:16px 18px;border-radius:18px;background:var(--navy);border:1px solid var(--border);color:var(--text);text-decoration:none;font-family:var(--font-body);transition:transform .2s,border-color .2s,box-shadow .2s}.ds-card:hover,.ds-card:focus-visible{outline:none;transform:translateY(-2px);border-color:var(--border-hover);box-shadow:0 8px 30px -12px rgba(0,0,0,.6)}.ds-card:active{transform:translateY(0)}.ds-card__icon{flex:none;display:grid;place-items:center;width:40px;height:40px;border-radius:12px;color:var(--cyan);background:rgba(0,177,226,.1)}.ds-card__icon svg{width:20px;height:20px}.ds-card__text{flex:1;min-width:0}.ds-card__title{display:block;font-family:var(--font-display);font-weight:600;font-size:14.5px;line-height:1.25}.ds-card__sub{display:block;margin-top:3px;font-size:12px;line-height:1.35;color:var(--muted)}.ds-card__chev{flex:none;width:18px;height:18px;color:var(--muted);transition:transform .2s,color .2s}.ds-card:hover .ds-card__chev{color:var(--cyan);transform:translateX(2px)}"
    },
